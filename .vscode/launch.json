{
  "version": "0.2.0",
  "configurations": [
    
    {
      "type": "node",
      "request": "launch",
      "name": "Start CoinVista Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open in Chrome",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "CoinVista: Server + Chrome",
      "configurations": ["Start CoinVista Server", "Open in Chrome"],
      "stopAll": true
    }
  ]
}
